<Project Sdk="Microsoft.NET.Sdk">

  <!-- axCalc's window side, as a class library inside Axit.exe (docs/axit/SPEC.md AX-1.7): the window, its key table
       and its texts; the pure code is AxCalc.Core. -->
  <PropertyGroup>
    <TargetFramework>$(AxitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxCalc</RootNamespace>
    <AssemblyName>axCalc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxCalc.Core\AxCalc.Core.csproj" />
    <ProjectReference Include="..\Axit.Core\Axit.Core.csproj" />
    <ProjectReference Include="..\Axit.Forms\Axit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axcalc\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
