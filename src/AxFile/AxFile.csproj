<Project Sdk="Microsoft.NET.Sdk">

  <!-- AxFile's window side, as a class library inside Axit.exe (docs/axit/SPEC.md AX-1.7): the window, its key table
       and its texts; the pure code is AxFile.Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxFile</RootNamespace>
    <AssemblyName>AxFile</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxFile.Core\AxFile.Core.csproj" />
    <ProjectReference Include="..\Axit.Core\Axit.Core.csproj" />
    <ProjectReference Include="..\Axit.Forms\Axit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axfile\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
