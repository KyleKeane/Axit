<Project Sdk="Microsoft.NET.Sdk">

  <!-- AxClaude's window, as a class library inside Axit.exe (docs/axit/SPEC.md AX-1.7, B-2); src/Axit is the executable. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxClaude</RootNamespace>
    <AssemblyName>AxClaude</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxClaude.Core\AxClaude.Core.csproj" />
    <ProjectReference Include="..\Axit.Core\Axit.Core.csproj" />
    <ProjectReference Include="..\Axit.Forms\Axit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file; publish.ps1 ships it next to the executable as README.md. -->
    <EmbeddedResource Include="..\..\docs\axclaude\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
