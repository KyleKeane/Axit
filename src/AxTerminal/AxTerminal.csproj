<Project Sdk="Microsoft.NET.Sdk">

  <!-- AxTerminal's window, as a class library inside Axit.exe (docs/axit/SPEC.md AX-1.7, B-2); src/Axit is the executable. -->
  <PropertyGroup>
    <TargetFramework>$(AxitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxTerminal</RootNamespace>
    <AssemblyName>AxTerminal</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxTerminal.Core\AxTerminal.Core.csproj" />
    <ProjectReference Include="..\Axit.Core\Axit.Core.csproj" />
    <ProjectReference Include="..\Axit.Forms\Axit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axterminal\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
