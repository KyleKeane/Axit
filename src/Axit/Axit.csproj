<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(AxitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Axit</RootNamespace>
    <AssemblyName>Axit</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>AxClaude.ico</ApplicationIcon>
    <Version>3.4.0</Version>
    <Product>Axit</Product>
    <Description>Accessible Windows apps for screen reader users: AxClaude, a front end for the Claude Code CLI, AxDown, a text editor, AxJSON, a JSON editor, AxGit, a git manager, AxTerminal, a terminal, AxFile, a file manager, AxMedia, a player, AxPreview, a viewer, and AxStart, a program launcher</Description>
    <Authors>Dr. Kyle Keane</Authors>
    <Company>Dr. Kyle Keane, www.kylekeane.com</Company>
    <Copyright>Copyright (c) 2026 Dr. Kyle Keane (www.kylekeane.com). MIT License.</Copyright>
  </PropertyGroup>

  <!-- One .ico per app next to this file (AxDown.ico to AxStart.ico; tools/make-icon.ps1 draws them) are the apps'
       icons for their Start menu and File Explorer entries (the executable's own icon is AxClaude's). publish.ps1
       copies every one of them next to the executable, since a single-file publish would bundle a project item
       into the executable, and install.ps1 copies them on. -->

  <ItemGroup>
    <ProjectReference Include="..\AxClaude\AxClaude.csproj" />
    <ProjectReference Include="..\AxDown\AxDown.csproj" />
    <ProjectReference Include="..\AxJSON\AxJSON.csproj" />
    <ProjectReference Include="..\AxGit\AxGit.csproj" />
    <ProjectReference Include="..\AxTerminal\AxTerminal.csproj" />
    <ProjectReference Include="..\AxFile\AxFile.csproj" />
    <ProjectReference Include="..\AxMedia\AxMedia.csproj" />
    <ProjectReference Include="..\AxPreview\AxPreview.csproj" />
    <ProjectReference Include="..\AxStart\AxStart.csproj" />
    <ProjectReference Include="..\Axit.Core\Axit.Core.csproj" />
  </ItemGroup>

</Project>
