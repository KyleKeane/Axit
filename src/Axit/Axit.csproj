<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(AxitDotNet)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Axit</RootNamespace>
    <AssemblyName>Axit</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>AxClaude.ico</ApplicationIcon>
    <Version>3.7.6</Version>
    <Product>Axit</Product>
    <Description>Accessible Windows apps for screen reader users: axClaude, a front end for the Claude Code CLI, axDown, a text editor, axJSON, a JSON editor, axGIT, a git manager, axTerminal, a terminal, axFile, a file manager, axMedia, a player, axPreview, a viewer, axStart, a program launcher, axProcess, a view of the processes, services and startup programs, axTask, tasks and lists, axPass, a KeePass password database, axCalc, a calculator, and axClip, a clipboard history</Description>
    <Authors>Dr. Kyle Keane</Authors>
    <Company>Dr. Kyle Keane, www.kylekeane.com</Company>
    <Copyright>Copyright (c) 2026 Dr. Kyle Keane (www.kylekeane.com). MIT License.</Copyright>
  </PropertyGroup>

  <!-- One .ico per app next to this file (AxDown.ico to AxClip.ico; tools/make-icon.ps1 draws them) are the apps'
       icons for their Start menu and File Explorer entries (the executable's own icon is axClaude's). publish.ps1
       copies every one of them next to the executable, since a single-file publish would bundle a project item
       into the executable, and install.ps1 copies them on. -->

  <!-- Every project of src: the apps' windows and their Cores, and the shared projects (docs/axit/app-kit.md AK-4.1),
       so that a new app's projects are referenced by being there. -->
  <ItemGroup>
    <ProjectReference Include="..\*\*.csproj" Exclude="..\Axit\Axit.csproj" />
  </ItemGroup>

</Project>
