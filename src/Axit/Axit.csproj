<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Axit</RootNamespace>
    <AssemblyName>Axit</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>AxClaude.ico</ApplicationIcon>
    <Version>3.3.1</Version>
    <Product>Axit</Product>
    <Description>Accessible Windows apps for screen reader users: AxClaude, a front end for the Claude Code CLI, AxDown, a text editor, AxJSON, a JSON editor, AxGit, a git manager, AxTerminal, a terminal, and AxFile, a file manager with a player</Description>
    <Authors>Dr. Kyle Keane</Authors>
    <Company>Dr. Kyle Keane, www.kylekeane.com</Company>
    <Copyright>Copyright (c) 2026 Dr. Kyle Keane (www.kylekeane.com). MIT License.</Copyright>
  </PropertyGroup>

  <!-- AxDown.ico, AxJSON.ico, AxGit.ico, AxTerminal.ico, AxFile.ico, AxMedia.ico and AxPreview.ico, next to this file, are the apps' icons for their Start menu
       and File Explorer entries (the executable's own icon is AxClaude's). publish.ps1 copies them next to the
       executable, since a single-file publish would bundle a project item into the executable, and install.ps1
       copies them on. -->

  <ItemGroup>
    <ProjectReference Include="..\AxClaude\AxClaude.csproj" />
    <ProjectReference Include="..\AxDown\AxDown.csproj" />
    <ProjectReference Include="..\AxJSON\AxJSON.csproj" />
    <ProjectReference Include="..\AxGit\AxGit.csproj" />
    <ProjectReference Include="..\AxTerminal\AxTerminal.csproj" />
    <ProjectReference Include="..\AxFile\AxFile.csproj" />
    <ProjectReference Include="..\AxMedia\AxMedia.csproj" />
    <ProjectReference Include="..\AxPreview\AxPreview.csproj" />
    <ProjectReference Include="..\AxStart\AxStart.csproj" />
    <ProjectReference Include="..\Axit.Core\Axit.Core.csproj" />
  </ItemGroup>

</Project>
