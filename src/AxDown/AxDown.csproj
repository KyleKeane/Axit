<Project Sdk="Microsoft.NET.Sdk">

  <!-- AxDown's window, as a class library inside Axit.exe (docs/axit/SPEC.md AX-1.7); the pure code is AxDown.Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AxDown</RootNamespace>
    <AssemblyName>AxDown</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxDown.Core\AxDown.Core.csproj" />
    <ProjectReference Include="..\Axit.Core\Axit.Core.csproj" />
    <ProjectReference Include="..\Axit.Forms\Axit.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help, User guide shows this file. -->
    <EmbeddedResource Include="..\..\docs\axdown\user-guide.md" LogicalName="UserGuide.md" />
  </ItemGroup>

</Project>
