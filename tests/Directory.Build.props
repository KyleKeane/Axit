<Project>

  <!-- What every test project is: xunit on .NET 10, not packed, with Xunit in scope. A project's own file holds only
       what differs: its framework when it needs WinForms, and the projects it tests. The root's rules still apply. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>$(AxitDotNet)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- As the executable runs (src/Axit/Axit.csproj): a test that passes only with the globalization data hides a
         defect of the shipped program (TextMatch.Fold relied on string.Normalize, which does nothing without the
         data; found 2026-10-23). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A lock file per test project (packages.lock.json, committed), so that a test run years from now restores
         exactly the packages that run today (docs/axit/longevity.md 3.12); Dependabot moves the lock files with the packages. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- In CI the lock files are the law: a package that does not match them fails the restore (security audit S-34). -->
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
