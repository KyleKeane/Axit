<Project>

  <PropertyGroup>
    <!-- The .NET version of every project, built into each TargetFramework ($(AxitDotNet) or $(AxitDotNet)-windows),
         so that the move to the next LTS is this line, global.json and a run of the tests. .NET 10 is supported until
         November 2028 (docs/axit/longevity.md). -->
    <AxitDotNet>net10.0</AxitDotNet>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The style rules of .editorconfig (braces, file-scoped namespaces, using order) are checked by every build;
         a Release build, which is what release.ps1 and the workflows run, fails on them. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Every project is Windows code: the WinForms ones say so by their framework, and this attribute says it for the
       pure ones (they call Windows through P/Invoke and COM: ConPTY, the shell, MFPlay) and for the tests. The analyzer
       then knows it; CA1416 warned on their Marshal and Thread calls and was silenced in .editorconfig until 2026-10-23
       (docs/axit/longevity.md 3.7). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
