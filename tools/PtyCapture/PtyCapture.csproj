<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AxitDotNet)</TargetFramework>
    <RootNamespace>PtyCapture</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- ClaudeLauncher and Redaction; the host itself is Axit.Core's. -->
    <ProjectReference Include="..\..\src\AxClaude.Core\AxClaude.Core.csproj" />
    <!-- ShellLauncher, for recording a shell the way AxTerminal starts it (the shell option). -->
    <ProjectReference Include="..\..\src\AxTerminal.Core\AxTerminal.Core.csproj" />
  </ItemGroup>

</Project>
